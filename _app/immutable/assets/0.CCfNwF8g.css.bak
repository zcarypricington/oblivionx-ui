html, body { border-radius: 12px; overflow: hidden; background-color: #0D0D0D !important; }


.splash-title.svelte-poqdeg {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: #ffffff;
  margin-top: 16px;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI Variable", "Segoe UI", Inter, sans-serif;
  opacity: 0.95;
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  animation: svelte-poqdeg-splash-lottie-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}


.splash-center.svelte-poqdeg::after {
  content: "constraintt.ez" !important;
  display: block !important;
  position: relative !important;
  z-index: 10 !important;
  font-family: var(--app-font, "Geist"), -apple-system, BlinkMacSystemFont, "Segoe UI Variable", "Segoe UI", Roboto, Inter, sans-serif !important;
  font-size: 26px !important;
  font-weight: 700 !important;
  letter-spacing: -0.025em !important;
  color: #ffffff !important;
  text-align: center !important;
  margin-top: -26px !important;
  opacity: 0;
  animation: splashWordmarkIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards !important;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7) !important;
  pointer-events: none !important;
}

@keyframes splashWordmarkIn {
  0% {
    opacity: 0;
    transform: translateY(10px) scale(0.96);
  }
  100% {
    opacity: 0.95;
    transform: translateY(0) scale(1);
  }
}
